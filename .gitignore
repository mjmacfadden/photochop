# Dependencies
node_modules/
archived/**/node_modules/

# Local env and secrets (never commit)
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# OS junk
.DS_Store
Thumbs.db
Desktop.ini

# Editor / IDE (prefer user-local settings)
.idea/
.vscode/
*.swp
*.swo
*~

# Caches / build tooling
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
*.tsbuildinfo
.npm/
.yarn/
.pnp.*

# Logs / coverage / temp
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
coverage/
.nyc_output/
tmp/
temp/
*.tmp

# dist/ policy:
# Keep committing dist/ for now so Live Server / static hosting works without
# CI-published artifacts. Do NOT add dist/ here and do NOT untrack dist/.
# Revisit when CI builds and deploys bundle.js.
